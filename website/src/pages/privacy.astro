---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageIntro from "../components/PageIntro.astro";
---

<SiteLayout
  title="Privacy — Metagent"
  description="How Metagent keeps agent inventory, usage evidence, and analysis local."
>
  <PageIntro
    eyebrow="Privacy"
    title="Local is the boundary."
    lede="Metagent inventories your agent setup without turning it into somebody else’s dataset."
  />

  <section class="section privacy-grid">
    <article class="privacy-card privacy-primary">
      <p class="card-label">Stored locally</p>
      <h2>Inventory and evidence remain on your Mac.</h2>
      <p>
        Generated inventory, normalized skill usage metadata, and cached
        evaluations live under your Library/Application Support directory.
      </p>
    </article>
    <article class="privacy-card">
      <p class="card-label">Not retained</p>
      <h3>No prompts or tool outputs.</h3>
      <p>
        Session indexing stores identity, timestamps, thread and turn IDs, and
        evidence metadata—not conversation content.
      </p>
    </article>
    <article class="privacy-card">
      <p class="card-label">Passive health</p>
      <h3>No surprise connections.</h3>
      <p>
        MCP health reads local configuration. It does not start servers, contact
        providers, refresh OAuth, or inspect secrets.
      </p>
    </article>
    <article class="privacy-card">
      <p class="card-label">Explicit boundary</p>
      <h3>Codex review requires confirmation.</h3>
      <p>
        Optional review sends only the selected, bounded skill copy to OpenAI
        after you confirm. It runs isolated from your broader configuration.
      </p>
    </article>
  </section>

  <section class="section storage-section">
    <div>
      <p class="eyebrow">Inspectable state</p>
      <h2>You can see where everything lives.</h2>
      <p>
        The filesystem remains authoritative. SQLite and JSON stores are local
        indexes for fast startup, usage evidence, and cached evaluation results.
      </p>
    </div>
    <div class="storage-list">
      <div><span>Inventory</span><code>inventory.sqlite</code></div>
      <div><span>Usage</span><code>usage.sqlite</code></div>
      <div><span>Evaluations</span><code>skill-evaluations-v1.json</code></div>
    </div>
  </section>
</SiteLayout>
