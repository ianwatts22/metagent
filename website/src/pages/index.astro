---
import SiteLayout from "../layouts/SiteLayout.astro";
import GitHubMark from "../components/GitHubMark.astro";
import Icon from "../components/Icon.astro";
import AppWindowMacIcon from "@hugeicons/core-free-icons/AppWindowMacIcon";
import CommandLineIcon from "@hugeicons/core-free-icons/CommandLineIcon";
import McpServerIcon from "@hugeicons/core-free-icons/McpServerIcon";

const surfaces = [
  {
    icon: AppWindowMacIcon,
    label: "App",
    detail: "Browse every skill and server you have, see what's actually earning its place, and clear out the rest.",
  },
  {
    icon: CommandLineIcon,
    label: "CLI",
    detail: "The same report as JSON, for any folder. Drop it in a script, a hook, or CI.",
  },
  {
    icon: McpServerIcon,
    label: "MCP",
    detail: "Your agent reads its own setup before it starts guessing. Read-only, always.",
  },
];

// Rows reflect what each surface actually ships today: app views from
// PanelSection/SkillTableView, CLI from its usage block, MCP from its tool list.
const matrix = [
  { name: "Browse skills and servers", app: true, cli: true, mcp: true },
  { name: "Full project report", app: true, cli: true, mcp: true },
  { name: "Health findings", app: true, cli: true, mcp: true },
  { name: "Real usage evidence", app: true, cli: true, mcp: true },
  { name: "Utility scores", app: true, cli: true, mcp: false },
  { name: "Duplicate detection", app: true, cli: false, mcp: false },
  { name: "Repair and remove", app: true, cli: true, mcp: false },
];

const sees = [
  { name: "Instructions", copy: "Which instruction files actually apply here." },
  { name: "Skills", copy: "What's in scope, and where it came from." },
  { name: "Servers", copy: "Which MCP servers this project is wired to." },
  { name: "Usage", copy: "What your agent has really been reaching for." },
  { name: "Health", copy: "What's worth fixing, without invented urgency." },
];
---

<SiteLayout>
  <section class="hero">
    <h1>Give your agent the workspace it deserves.</h1>
    <p class="hero-lede">
      Metagent turns scattered skills, MCP servers, and instructions into one
      tidy system—so your agents have room to succeed.
    </p>
    <div class="hero-actions">
      <a
        class="primary-button"
        href="https://github.com/ianwatts22/metagent/releases/latest/download/Metagent.zip"
      >
        Download
      </a>
      <a class="secondary-button" href="https://github.com/ianwatts22/metagent">
        <GitHubMark size={15} /> GitHub
      </a>
    </div>
    <img
      class="hero-shot"
      src="/app-overview.webp"
      width="1800"
      height="1188"
      alt="The Metagent app's overview: unused and never-used skill counts, reads per skill, token totals, and MCP connections"
    />
  </section>

  <section class="section centered">
    <h2>Agent setup should be inspectable, not archaeological.</h2>
    <p class="section-lede">
      Configured, installed, observed, and healthy are four different things.
      Metagent keeps them apart instead of flattening them into one status.
    </p>
  </section>

  <section class="section centered">
    <h2>Human and agent friendly.</h2>
    <div class="surface-grid">
      {surfaces.map((surface) => (
        <article class="surface-card" tabindex="0">
          <div class="surface-id">
            <Icon icon={surface.icon} size={148} stroke={0.85} />
            <p class="card-label">{surface.label}</p>
          </div>
          <p class="surface-detail"><span>{surface.detail}</span></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section centered">
    <h2>Complete context control.</h2>
    <p class="section-lede">
      Point it at a folder and it reports on five things—metadata only, never
      the contents of your instructions.
    </p>
    <div class="sees-grid">
      {sees.map((item) => (
        <article class="sees-card">
          <h3>{item.name}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section centered">
    <h2>Capabilities</h2>
    <div class="matrix-wrap">
      <table class="matrix">
        <thead>
          <tr><th>Capability</th><th>App</th><th>CLI</th><th>MCP</th></tr>
        </thead>
        <tbody>
          {matrix.map((row) => (
            <tr>
              <th scope="row">{row.name}</th>
              {[row.app, row.cli, row.mcp].map((has) => (
                <td>
                  {has
                    ? <span class="yes" role="img" aria-label="yes">✓</span>
                    : <span class="no" role="img" aria-label="no">·</span>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section centered closing">
    <h2>100% free &amp; local.</h2>
    <p class="section-lede">
      Metagent reads your agent logs and writes its analysis to a SQLite file on
      your own disk. No account, no server, nothing to upload.
    </p>
    <a
      class="primary-button"
      href="https://github.com/ianwatts22/metagent/releases/latest/download/Metagent.zip"
    >
      Download
    </a>
  </section>
</SiteLayout>
