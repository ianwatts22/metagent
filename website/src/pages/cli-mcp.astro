---
import SiteLayout from "../layouts/SiteLayout.astro";
import CommandBlock from "../components/CommandBlock.astro";

const tools = [
  {
    name: "analyze_project",
    copy: "The combined project report: instructions, skills, MCP configuration, usage, Doctor findings, and up to five prioritized actions.",
  },
  {
    name: "get_project_analysis_details",
    copy: "Page through one section of that report when the summary isn't enough. Capped at 100 records per call.",
  },
  {
    name: "list_skills",
    copy: "The skills found in the project folder, with their scope and origin.",
  },
  {
    name: "doctor_project",
    copy: "Actionable configuration findings, grouped by severity.",
  },
];

const sections = [
  { name: "Instructions", copy: "Which agent instruction files apply to this folder." },
  { name: "Skills", copy: "Skills in scope, where each came from, and how often it gets used." },
  { name: "MCP", copy: "Which MCP servers this project is configured to use." },
  { name: "Usage", copy: "Observed skill usage from your local agent logs." },
  { name: "Doctor", copy: "Findings worth fixing, without inventing urgency." },
];
---

<SiteLayout
  title="CLI and MCP — Metagent"
  description="Install the Metagent CLI and connect the local MCP server to Codex or Claude."
>
  <section class="section guide">
    <h1>CLI and MCP</h1>
    <p class="guide-lede">
      The same analysis the app runs, available in your terminal and to your
      coding agents. Everything runs locally and reads only.
    </p>

    <div class="step-block">
      <header class="sheet-head"><b>01</b> Install the CLI</header>
      <p>The app bundles its own copy, so this is only needed to run <code>metagent</code> yourself.</p>
      <CommandBlock command="./scripts/install-cli.sh" label="CLI install command" />
      <p class="note">Installs to <code>~/.local/bin/metagent</code>. Make sure that is on your PATH.</p>
    </div>

    <div class="step-block">
      <header class="sheet-head"><b>02</b> Connect your agent</header>
      <p>Registers the MCP server with Codex and Claude Code.</p>
      <CommandBlock command="metagent mcp install --apply" label="MCP install command" />
      <p class="note">Drop <code>--apply</code> to preview the change first, and confirm it worked with <code>metagent mcp status</code>.</p>
    </div>

    <div class="step-block">
      <header class="sheet-head"><b>03</b> Analyze a project</header>
      <p>Point it at any folder to get the full report.</p>
      <CommandBlock command="metagent analyze --root . --json" label="project analysis command" />
    </div>
  </section>

  <section class="section guide">
    <header class="sheet-head"><b>04</b> What your agent gets</header>
    <h2>Four read-only tools.</h2>
    <dl class="def-list">
      {tools.map((tool) => (
        <div>
          <dt><code>{tool.name}</code></dt>
          <dd>{tool.copy}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section guide">
    <header class="sheet-head"><b>05</b> What it can see</header>
    <h2>Five sections, one folder.</h2>
    <p class="guide-lede">
      Every tool is scoped to the folder you point it at, and reports
      metadata—not the contents of your instruction files.
    </p>
    <dl class="def-list">
      {sections.map((section) => (
        <div>
          <dt>{section.name}</dt>
          <dd>{section.copy}</dd>
        </div>
      ))}
    </dl>
  </section>
</SiteLayout>
